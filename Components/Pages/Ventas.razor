@page "/ventas"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin, Operador")]
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    @* ENCABEZADO *@
    <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center" GutterBottom="true"><b>Catálogo y Ventas</b></MudText>
    <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6" Style="color: #78909C;">
        Seleccione los productos del catálogo para agregarlos al carrito y registre la venta.
    </MudText>

    <MudGrid>
        @* ZONA IZQUIERDA: CATÁLOGO DE PRODUCTOS (Alex trabajará aquí) *@
        <MudItem xs="12" md="8">
            <MudPaper Elevation="3" Class="pa-4" Style="background-color: transparent; box-shadow: none;">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">Productos Disponibles</MudText>

                <MudGrid>
                    @* EJEMPLO DE TARJETA DE PRODUCTO PARA ALEX *@
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="4" Style="border-radius: 8px;">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1" Class="fw-bold" Color="Color.Primary">Producto de Ejemplo</MudText>
                                <MudText Typo="Typo.body2" Style="color: #78909C;">Categoría Base</MudText>
                                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">$ 1.500,00</MudText>
                                <MudChip T="string" Size="Size.Small" Style="background-color: #ECEFF1; color: #546E7A;" Class="mt-2">Stock: 10</MudChip>
                            </MudCardContent>
                            <MudCardActions Class="d-flex justify-end">
                                @* Botón con icono de carrito usando la paleta Primary *@
                                <MudIconButton Icon="@Icons.Material.Filled.AddShoppingCart" Color="Color.Primary" />
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        @* ZONA DERECHA: CARRITO DE COMPRAS *@
        <MudItem xs="12" md="4">
            <MudPaper Elevation="3" Class="pa-4 d-flex flex-column" Style="height: 100%; border-radius: 8px;">
                <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" />
                    Carrito
                </MudText>

                <MudDivider Class="mb-4" />

                @* Aquí Alex deberá iterar la lista del carrito *@
                <div class="flex-grow-1" style="min-height: 200px;">
                    <MudText Typo="Typo.body2" Align="Align.Center" Style="color: #B0BEC5; margin-top: 50px;">
                        El carrito está vacío.
                    </MudText>
                </div>

                <MudDivider Class="my-4" />

                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h6" Color="Color.Primary">Total:</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Secondary" Class="fw-bold">$ 0,00</MudText>
                </div>

                @* Botón principal de cobrar (Lima) *@
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" FullWidth="true" Class="mud-elevation-8">
                    Confirmar Venta
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    // Alex deberá inyectar HttpClient y manejar sus listas de productos acá
}