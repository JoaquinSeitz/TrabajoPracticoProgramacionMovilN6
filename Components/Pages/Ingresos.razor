@page "/ingresos"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center" GutterBottom="true"><b>Ingresos</b></MudText>
    <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary mb-6">
        Busque el producto y seleccione el proveedor para registrar ingresos de stock o darlo de baja del catálogo.
    </MudText>

    <MudText Typo="Typo.subtitle2" Color="Color.Info" Class="mb-2">
        Productos activos: @productos.Count
    </MudText>

    <MudPaper Elevation="3" Class="pa-6">
        <MudGrid>
            @* 1. Buscador de Producto *@
            <MudItem xs="12" md="5">
                <div style="position: relative; flex-grow: 1;">
                    <MudTextField T="string"
                                  Label="Buscar Producto"
                                  @bind-Value="txtBusqueda"
                                  @bind-Value:after="AlEscribir"
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnFocus="MostrarListaCompleta" />

                    @if (mostrarDropdown && sugerencias.Any())
                    {
                        <MudPaper Elevation="4" Style="position: absolute; top: 100%; left: 0; right: 0; z-index: 100; max-height: 250px; overflow-y: auto;">
                            <MudList T="ProductoResponseDTO" Clickable="true">
                                @foreach (var prod in sugerencias)
                                {
                                    <MudListItem OnClick="() => SeleccionarProducto(prod)">
                                        <MudText>
                                            @prod.Nombre
                                            <MudChip T="string" Size="Size.Small" Style="background-color: #ECEFF1; color: #546E7A;" Class="ms-2">Stock: @prod.Stock</MudChip>
                                        </MudText>
                                    </MudListItem>
                                }
                            </MudList>
                        </MudPaper>
                    }
                </div>
            </MudItem>

            @* 2. Selector de Proveedor (NUEVO) *@
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_proveedorSeleccionadoId" Label="Proveedor" Variant="Variant.Outlined">
                    <MudSelectItem Value="0" Disabled="true">Seleccione Proveedor</MudSelectItem>
                    @foreach (var prov in proveedores)
                    {
                        <MudSelectItem Value="@prov.ProveedorId">@prov.RazonSocial</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @* 3. Cantidad y Botón Nuevo *@
            <MudItem xs="12" md="3" Class="d-flex align-center gap-2">
                <MudNumericField T="int" Label="Cantidad" @bind-Value="cantidadAIngresar" Variant="Variant.Outlined" Min="1" Max="1000" />
                
                <MudIconButton Icon="@Icons.Material.Filled.Add" 
                               Color="Color.Primary" 
                               Variant="Variant.Filled" 
                               Size="Size.Medium" 
                               OnClick="AbrirModalNuevoProducto" 
                               Title="Crear Nuevo Producto" />
            </MudItem>
            
            @* Botones centrados *@
            <MudItem xs="12" Class="d-flex justify-center mt-4 gap-3">
                @if (productoSeleccionado != null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Large" StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="DeshabilitarProducto" Disabled="@_cargando">
                        Deshabilitar
                    </MudButton>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Save" OnClick="RegistrarIngreso" Disabled="@_cargando" Class="mud-elevation-8">
                    @if (_cargando)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Surface" />
                        <MudText Class="ms-2">Procesando...</MudText>
                    }
                    else
                    {
                        <MudText>Registrar Ingreso</MudText>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@* --- MODAL PARA CREAR NUEVO PRODUCTO --- *@
<MudDialog @bind-Visible="_modalProductoVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-2"/> Nuevo Producto
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_formProducto" Model="@_nuevoProducto">
            <MudTextField @bind-Value="_nuevoProducto.Nombre" For="@(() => _nuevoProducto.Nombre)" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            
            <div class="d-flex gap-3 mb-3">
                 <MudNumericField @bind-Value="_nuevoProducto.Precio" For="@(() => _nuevoProducto.Precio)" Label="Precio" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                 <MudNumericField @bind-Value="_nuevoProducto.Stock" For="@(() => _nuevoProducto.Stock)" Label="Stock Inicial" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
            </div>

            <div class="d-flex gap-3 mb-3">
                <MudSelect T="int" @bind-Value="_nuevoProducto.CategoriaId" For="@(() => _nuevoProducto.CategoriaId)" Label="Categoría" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var cat in categorias)
                    {
                        <MudSelectItem Value="@cat.CategoriaId">@cat.Nombre</MudSelectItem>
                    }
                </MudSelect>

                @* NUEVO SELECTOR DE PROVEEDOR EN EL MODAL *@
                <MudSelect T="int" @bind-Value="_nuevoProducto.ProveedorId" For="@(() => _nuevoProducto.ProveedorId)" Label="Proveedor del Stock Inicial" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_nuevoProducto.Stock <= 0)">
                    <MudSelectItem Value="0" Disabled="true">Seleccione Proveedor</MudSelectItem>
                    @foreach (var prov in proveedores)
                    {
                        <MudSelectItem Value="@prov.ProveedorId">@prov.RazonSocial</MudSelectItem>
                    }
                </MudSelect>
            </div>
            
            <MudFileUpload T="IBrowserFile" FilesChanged="CargarImagen" Accept=".jpg, .jpeg, .png, .webp">
                <ActivatorContent>
                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        Subir Foto (Opcional)
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            
            @if (_archivoImagen != null)
            {
                 <MudText Typo="Typo.caption" Color="Color.Success" Class="d-block mt-1">Archivo listo: @_archivoImagen.Name</MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _modalProductoVisible = false">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GuardarNuevoProducto" Disabled="@_guardandoProducto">
            @if (_guardandoProducto)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText>Guardar Producto</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _cargando = false;
    private int cantidadAIngresar = 1;
    private int _proveedorSeleccionadoId = 0; // NUEVO
    
    private List<ProductoResponseDTO> productos = new();
    private List<CategoriaResponseDTO> categorias = new();
    private List<ProveedorResponseDTO> proveedores = new(); // NUEVO
    
    private ProductoResponseDTO? productoSeleccionado;
    private string txtBusqueda = "";
    private bool mostrarDropdown = false;
    private List<ProductoResponseDTO> sugerencias = new();

    private bool _modalProductoVisible;
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    private MudForm _formProducto = default!;
    private ProductoCreateDTO _nuevoProducto = new();
    private bool _guardandoProducto = false;
    private IBrowserFile? _archivoImagen;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
        await CargarCategorias();
        await CargarProveedores(); // NUEVO
    }

    private async Task CargarProveedores()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<ProveedorResponseDTO>>("/api/Proveedores?pageSize=100");
            if (response != null)
            {
                proveedores = response;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar proveedores: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarProductos()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<ProductoResponseDTO>>("/api/Productos?pageSize=100");
            if (response != null)
            {
                productos = response;
                sugerencias = productos;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar el catálogo: {ex.Message}", Severity.Error);
        }
    }

    private async Task CargarCategorias()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<CategoriaResponseDTO>>("/api/Categorias");
            if (response != null && response.Any())
            {
                categorias = response;
            }
            else
            {
                categorias = new List<CategoriaResponseDTO> { new CategoriaResponseDTO { CategoriaId = 1, Nombre = "General / Sin Categoría" } };
            }
        }
        catch (Exception)
        {
            categorias = new List<CategoriaResponseDTO> { new CategoriaResponseDTO { CategoriaId = 1, Nombre = "General / Sin Categoría" } };
        }
        StateHasChanged();
    }

    private void AlEscribir()
    {
        productoSeleccionado = null;
        if (string.IsNullOrWhiteSpace(txtBusqueda))
        {
            sugerencias = productos;
        }
        else
        {
            sugerencias = productos
                .Where(p => p.Nombre.Contains(txtBusqueda, StringComparison.InvariantCultureIgnoreCase))
                .ToList();
        }
        mostrarDropdown = true;
    }

    private void MostrarListaCompleta()
    {
        if (string.IsNullOrWhiteSpace(txtBusqueda))
        {
            sugerencias = productos;
        }
        mostrarDropdown = true;
    }

    private void SeleccionarProducto(ProductoResponseDTO prod)
    {
        productoSeleccionado = prod;
        txtBusqueda = prod.Nombre;
        mostrarDropdown = false;
    }

    private async Task RegistrarIngreso()
    {
        if (productoSeleccionado == null)
        {
            Snackbar.Add("Por favor, seleccione un producto de la lista desplegable.", Severity.Warning);
            return;
        }

        if (_proveedorSeleccionadoId == 0)
        {
            Snackbar.Add("Por favor, seleccione un proveedor.", Severity.Warning);
            return;
        }

        if (cantidadAIngresar <= 0 || cantidadAIngresar > 1000)
        {
            Snackbar.Add("La cantidad debe estar entre 1 y 1000 unidades.", Severity.Warning);
            return;
        }

        int nuevoStock = productoSeleccionado.Stock + cantidadAIngresar;
        string nombreProveedor = proveedores.FirstOrDefault(p => p.ProveedorId == _proveedorSeleccionadoId)?.RazonSocial ?? "Desconocido";

        MarkupString mensajeHtml = new MarkupString(
            $"<div style='text-align: center; padding: 5px;'>" +
            $"<p style='font-size: 16px; margin-bottom: 10px;'>¿Confirma agregar <b>{cantidadAIngresar}</b> unidades de <br/><span style='color: #827717; font-size: 18px; font-weight: bold;'>{productoSeleccionado.Nombre}</span>?</p>" +
            $"<p style='font-size: 13px; color: #546E7A; margin-bottom: 15px;'>Proveedor: <b>{nombreProveedor}</b></p>" +
            $"<div style='display: flex; justify-content: space-around; background-color: #ECEFF1; padding: 10px; border-radius: 8px;'>" +
            $"<div><span style='color: #546E7A; font-size: 12px;'>Stock actual</span><br/><b style='font-size: 16px;'>{productoSeleccionado.Stock}</b></div>" +
            $"<div><span style='color: #546E7A; font-size: 12px;'>Nuevo stock</span><br/><b style='color: #AFB42B; font-size: 18px;'>{nuevoStock}</b></div>" +
            $"</div></div>"
        );

        bool? confirmado = await DialogService.ShowMessageBoxAsync(
            "Validación de Stock",
            markupMessage: mensajeHtml,
            yesText: "Confirmar y Guardar",
            cancelText: "Cancelar"
        );

        if (confirmado != true) return;

        _cargando = true;
        StateHasChanged();

        try
        {
            var ingresoDto = new IngresoProductoRequestDTO
            {
                ProveedorId = _proveedorSeleccionadoId, 
                UsuarioId = 1, // (Idealmente se saca del token/sesión)
                Detalles = new List<DetalleMovimientoRequestDTO>
                {
                    new DetalleMovimientoRequestDTO
                    {
                        ProductoId = productoSeleccionado.ProductoId,
                        Cantidad = cantidadAIngresar
                    }
                }
            };

            var response = await Http.PostAsJsonAsync("/api/IngresoProductos", ingresoDto);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Ingreso registrado correctamente. Nuevo stock: {nuevoStock}", Severity.Success);

                cantidadAIngresar = 1;
                productoSeleccionado = null;
                txtBusqueda = "";
                _proveedorSeleccionadoId = 0; // Reiniciamos el selector
                mostrarDropdown = false;

                await CargarProductos();
            }
            else
            {
                Snackbar.Add("Error al registrar el ingreso. Verifique los datos.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    // --- MÉTODO PARA DESHABILITAR PRODUCTO (INTACTO) ---
    private async Task DeshabilitarProducto()
    {
        if (productoSeleccionado == null) return;

        MarkupString mensajeBajaHtml = new MarkupString(
            $"<div style='text-align: center; padding: 5px;'>" +
            $"<p style='font-size: 16px; margin-bottom: 10px;'>¿Está seguro que desea deshabilitar <br/><span style='color: #D32F2F; font-size: 18px; font-weight: bold;'>{productoSeleccionado.Nombre}</span>?</p>" +
            $"<div style='background-color: #FFEBEE; padding: 10px; border-radius: 8px; margin-top: 15px;'>" +
            $"<span style='color: #C62828; font-size: 13px; font-weight: 500;'>El producto se ocultará del catálogo para los clientes.</span>" +
            $"</div></div>"
        );

        bool? confirmado = await DialogService.ShowMessageBoxAsync(
            "Dar de baja producto",
            markupMessage: mensajeBajaHtml,
            yesText: "Sí, Deshabilitar",
            cancelText: "Cancelar"
        );

        if (confirmado != true) return;

        _cargando = true;
        StateHasChanged();

        try
        {
            var response = await Http.DeleteAsync($"/api/Productos/{productoSeleccionado.ProductoId}");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Producto deshabilitado correctamente.", Severity.Success);
                
                productoSeleccionado = null;
                txtBusqueda = "";
                cantidadAIngresar = 1;
                mostrarDropdown = false;
                
                await CargarProductos();
            }
            else
            {
                Snackbar.Add("No se pudo deshabilitar el producto.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    private void AbrirModalNuevoProducto()
    {
        _nuevoProducto = new ProductoCreateDTO { ProveedorId = 0 }; // Iniciamos proveedor en 0
        _archivoImagen = null;
        _modalProductoVisible = true;
    }

    private void CargarImagen(IBrowserFile file)
    {
        _archivoImagen = file;
    }

    // --- MODAL DE NUEVO PRODUCTO (CON VALIDACIÓN DE PROVEEDOR) ---
    private async Task GuardarNuevoProducto()
    {
        // Bypass temporal: si el stock es 0, asignamos un proveedor ficticio solo para pasar la validación del modelo
        if (_nuevoProducto.Stock == 0) _nuevoProducto.ProveedorId = 1; 

        await _formProducto.ValidateAsync();
        if (!_formProducto.IsValid)
        {
            Snackbar.Add("Por favor, corrija los errores en el formulario.", Severity.Warning);
            return;
        }

        // Si ingresó stock > 0, obligamos a que haya seleccionado un proveedor válido de la lista
        if (_nuevoProducto.Stock > 0 && (_nuevoProducto.ProveedorId == 0 || (_nuevoProducto.ProveedorId == 1 && proveedores.All(p => p.ProveedorId != 1))))
        {
            Snackbar.Add("Si ingresa stock inicial, debe seleccionar un proveedor válido.", Severity.Warning);
            return;
        }

        var categoriaSeleccionada = categorias.FirstOrDefault(c => c.CategoriaId == _nuevoProducto.CategoriaId);
        string nombreCategoria = categoriaSeleccionada != null ? categoriaSeleccionada.Nombre : "Desconocida";
        string nombreArchivo = _archivoImagen != null ? _archivoImagen.Name : "Sin imagen asignada";
        
        // Recuperamos el nombre del proveedor para mostrarlo en el modal
        string nombreProveedor = _nuevoProducto.Stock > 0 
            ? (proveedores.FirstOrDefault(p => p.ProveedorId == _nuevoProducto.ProveedorId)?.RazonSocial ?? "Desconocido") 
            : "N/A (Sin stock inicial)";

        MarkupString mensajeAltaHtml = new MarkupString(
            $"<div style='text-align: center; padding: 5px;'>" +
            $"<p style='font-size: 16px; margin-bottom: 10px;'>¿Confirma la creación de <br/><span style='color: #827717; font-size: 18px; font-weight: bold;'>{_nuevoProducto.Nombre}</span>?</p>" +
            $"<div style='display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-around; background-color: #ECEFF1; padding: 10px; border-radius: 8px;'>" +
            $"<div style='text-align: center;'><span style='color: #546E7A; font-size: 12px;'>Categoría</span><br/><b style='font-size: 14px; color: #455A64;'>{nombreCategoria}</b></div>" +
            $"<div style='text-align: center;'><span style='color: #546E7A; font-size: 12px;'>Precio</span><br/><b style='font-size: 14px; color: #455A64;'>${_nuevoProducto.Precio}</b></div>" +
            $"<div style='text-align: center;'><span style='color: #546E7A; font-size: 12px;'>Stock Inicial</span><br/><b style='color: #AFB42B; font-size: 16px;'>{_nuevoProducto.Stock}</b></div>" +
            $"<div style='text-align: center; width: 100%; margin-top: 5px;'><span style='color: #546E7A; font-size: 12px;'>Proveedor</span><br/><b style='font-size: 12px; color: #455A64;'>{nombreProveedor}</b></div>" +
            $"</div>" +
            $"<div style='margin-top: 10px; font-size: 12px; color: #78909C;'>Archivo: {nombreArchivo}</div>" +
            $"</div>"
        );

        bool? confirmado = await DialogService.ShowMessageBoxAsync(
            "Confirmar Alta de Producto",
            markupMessage: mensajeAltaHtml,
            yesText: "Crear Producto",
            cancelText: "Revisar datos"
        );

        if (confirmado != true) return;

        _guardandoProducto = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("/api/Productos", _nuevoProducto);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RespuestaCreacionDTO>();
                
                if (result != null && result.ProductoId > 0 && _archivoImagen != null)
                {
                    using var content = new MultipartFormDataContent();
                    var streamContent = new StreamContent(_archivoImagen.OpenReadStream(10485760)); 
                    streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_archivoImagen.ContentType);
                    content.Add(streamContent, "archivo", _archivoImagen.Name);

                    var uploadResponse = await Http.PostAsync($"/api/Productos/{result.ProductoId}/imagen", content);
                    
                    if (!uploadResponse.IsSuccessStatusCode)
                    {
                         Snackbar.Add("El producto se creó, pero falló la subida de la foto.", Severity.Warning);
                    }
                }

                Snackbar.Add("Producto creado e integrado al catálogo exitosamente.", Severity.Success);
                _modalProductoVisible = false;
                
                await CargarProductos(); 
                if (result != null)
                {
                    var recienCreado = productos.FirstOrDefault(p => p.ProductoId == result.ProductoId);
                    if (recienCreado != null)
                    {
                        SeleccionarProducto(recienCreado);
                    }
                }
            }
            else
            {
                Snackbar.Add("Error al registrar el producto.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _guardandoProducto = false;
            StateHasChanged();
        }
    }

    public class ProductoResponseDTO
    {
        public int ProductoId { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public decimal Precio { get; set; }
        public int Stock { get; set; }
        public string? Imagen { get; set; }
        public int CategoriaId { get; set; }
        public string CategoriaNombre { get; set; } = string.Empty;
    }

    public class CategoriaResponseDTO
    {
        public int CategoriaId { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }

    // NUEVO DTO
    public class ProveedorResponseDTO 
    { 
        public int ProveedorId { get; set; } 
        public string RazonSocial { get; set; } = string.Empty; 
    }

    public class ProductoCreateDTO
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [MinLength(3, ErrorMessage = "El nombre debe tener al menos 3 letras.")]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "El precio es obligatorio.")]
        [Range(0.01, double.MaxValue, ErrorMessage = "El precio debe ser mayor a 0.")]
        public decimal Precio { get; set; }

        [Range(0, int.MaxValue, ErrorMessage = "El stock no puede ser negativo.")]
        public int Stock { get; set; }

        public string? Imagen { get; set; }

        [Required(ErrorMessage = "Debe seleccionar una categoría.")]
        [Range(1, int.MaxValue, ErrorMessage = "Seleccione una categoría válida.")]
        public int CategoriaId { get; set; }

        // NUEVO CAMPO
        public int ProveedorId { get; set; } 
    }

    public class RespuestaCreacionDTO
    {
        public string mensaje { get; set; } = string.Empty;
        public int ProductoId { get; set; }
    }

    public class IngresoProductoRequestDTO
    {
        public int ProveedorId { get; set; }
        public int UsuarioId { get; set; }
        public List<DetalleMovimientoRequestDTO> Detalles { get; set; } = new();
    }

    public class DetalleMovimientoRequestDTO
    {
        public int ProductoId { get; set; }
        public int Cantidad { get; set; }
    }
}