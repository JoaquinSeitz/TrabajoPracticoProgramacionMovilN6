@page "/reportes"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8 mb-16">
    <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center" GutterBottom="true"><b>Reportes del Sistema</b></MudText>
    <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6 mud-text-secondary">
        Genere y descargue los documentos consolidados en formato PDF.
    </MudText>

    <MudGrid Class="justify-center">
        @* 1. REPORTE DE STOCK *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Style="border-radius: 8px; height: 100%; display: flex; flex-direction: column;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Color="Color.Primary">Reporte de Stock</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="flex-grow-1">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Genera una instantánea del stock disponible, detallando cantidad y precio de cada producto activo.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="d-flex justify-end pa-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DescargarPdfStock" Disabled="@_descargandoStock">
                        @if (_descargandoStock)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Surface" />
                        }
                        else
                        {
                            <MudText>Generar</MudText>
                        }
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* 2. AUDITORÍA DE VENTAS *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Style="border-radius: 8px; height: 100%; display: flex; flex-direction: column;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Info" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.PointOfSale" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Color="Color.Primary">Auditoría de Ventas</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="flex-grow-1">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                        Listado histórico de todas las salidas registradas y la recaudación consolidada.
                    </MudText>
                    <MudDatePicker Label="Filtrar por Fecha" @bind-Date="_fechaVentas" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Color="Color.Info" />
                </MudCardContent>
                <MudCardActions Class="d-flex justify-end pa-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DescargarAuditoriaVentas" Disabled="@_descargandoVentas">
                        @if (_descargandoVentas)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Surface" />
                        }
                        else
                        {
                            <MudText>Generar</MudText>
                        }
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        @* 3. AUDITORÍA DE INGRESOS *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="4" Style="border-radius: 8px; height: 100%; display: flex; flex-direction: column;">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" />
                        </MudAvatar>
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Color="Color.Primary">Auditoría de Ingresos</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="flex-grow-1">
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
                        Listado histórico de todas las entradas de mercadería al inventario.
                    </MudText>
                    <MudDatePicker Label="Filtrar por Fecha" @bind-Date="_fechaIngresos" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Color="Color.Success" />
                </MudCardContent>
                <MudCardActions Class="d-flex justify-end pa-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DescargarAuditoriaIngresos" Disabled="@_descargandoIngresos">
                        @if (_descargandoIngresos)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" Color="Color.Surface" />
                        }
                        else
                        {
                            <MudText>Generar</MudText>
                        }
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private bool _descargandoStock = false;
    private bool _descargandoVentas = false;
    private bool _descargandoIngresos = false;

    // Variables para los filtros de fecha (null significa "traer todo")
    private DateTime? _fechaVentas = null;
    private DateTime? _fechaIngresos = null;

    private async Task DescargarPdfStock()
    {
        _descargandoStock = true;
        await ProcesarDescarga("/api/Reportes/stock", $"ReporteStock_{DateTime.Now:ddMMyyyy}.pdf");
        _descargandoStock = false;
    }

    private async Task DescargarAuditoriaVentas()
    {
        _descargandoVentas = true;

        // Adjuntamos la fecha seleccionada a la URL si existe
        string url = "/api/Reportes/auditoria-ventas";
        if (_fechaVentas.HasValue)
        {
            url += $"?fecha={_fechaVentas.Value:yyyy-MM-dd}";
        }

        await ProcesarDescarga(url, $"AuditoriaVentas_{DateTime.Now:ddMMyyyy}.pdf");
        _descargandoVentas = false;
    }

    private async Task DescargarAuditoriaIngresos()
    {
        _descargandoIngresos = true;

        // Adjuntamos la fecha seleccionada a la URL si existe
        string url = "/api/Reportes/auditoria-ingresos";
        if (_fechaIngresos.HasValue)
        {
            url += $"?fecha={_fechaIngresos.Value:yyyy-MM-dd}";
        }

        await ProcesarDescarga(url, $"AuditoriaIngresos_{DateTime.Now:ddMMyyyy}.pdf");
        _descargandoIngresos = false;
    }

    private async Task ProcesarDescarga(string url, string nombreArchivo)
    {
        try
        {
            // Usamos GetAsync para poder leer el código de estado HTTP
            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var pdfBytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(pdfBytes);

                await JS.InvokeVoidAsync("descargarArchivo", nombreArchivo, "application/pdf", base64);
                Snackbar.Add($"{nombreArchivo} descargado exitosamente.", Severity.Success);
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // Si el backend devuelve NotFound (404), mostramos tu mensaje exacto
                Snackbar.Add("No hay registros.", Severity.Warning);
            }
            else
            {
                Snackbar.Add("Error al generar el documento desde el servidor.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
    }
}