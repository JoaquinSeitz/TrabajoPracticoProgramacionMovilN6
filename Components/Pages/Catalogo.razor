@page "/catalogo"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TrabajoPracticoProgramacionMovilN6.Models
@using TrabajoPracticoProgramacionMovilN6.Services
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject CarritoService ServicioCarrito
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-16">
    <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Center" GutterBottom="true"><b>Catálogo de Productos</b></MudText>
    <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6" Style="color: #78909C;">
        Explorá nuestro inventario y agregá los productos al carrito.
    </MudText>

    <MudGrid>
        @if (productos == null)
        {
            <MudItem xs="12" Class="d-flex justify-center mt-10">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </MudItem>
        }
        else
        {
            @foreach (var prod in productos)
            {
                <MudItem xs="6" sm="4" md="3">
                    <MudCard Elevation="4" Style="border-radius: 8px; height: 100%; display: flex; flex-direction: column;">
                        
                        <MudCardMedia Image="@(string.IsNullOrEmpty(prod.Imagen) ? "/img/no-image.png" : $"https://localhost:7133{prod.Imagen}")" Height="140" Style="object-fit: contain; padding: 10px;" />

                        <MudCardContent Class="flex-grow-1">
                            <MudText Typo="Typo.subtitle1" Class="fw-bold" Color="Color.Primary">@prod.Nombre</MudText>
                            <MudText Typo="Typo.body2" Style="color: #78909C;">@prod.CategoriaNombre</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-2">@prod.Precio.ToString("C")</MudText>
                            <MudText Typo="Typo.caption" Style="color: #546E7A;">Stock disponible: @prod.Stock</MudText>
                        </MudCardContent>

                        <MudCardActions Class="d-flex justify-end pa-3">
                            <AuthorizeView Context="authContext">
                                <Authorized>
                                    @* Solo mostramos el botón si el usuario autenticado tiene el rol "Cliente" *@
                                    @if (authContext.User.IsInRole("Cliente"))
                                    {
                                        <MudButton Variant="Variant.Filled" 
                                                   Color="Color.Secondary" 
                                                   Size="Size.Small" 
                                                   StartIcon="@Icons.Material.Filled.AddShoppingCart" 
                                                   Class="mud-elevation-4"
                                                   Disabled="@(prod.Stock == 0)"
                                                   OnClick="() => AgregarAlCarrito(prod)">
                                            @(prod.Stock > 0 ? "Agregar" : "Agotado")
                                        </MudButton>
                                    }
                                </Authorized>
                                <NotAuthorized>
                                    @* Si nadie inició sesión, mostramos el botón para que al hacer clic le pida loguearse *@
                                    <MudButton Variant="Variant.Filled" 
                                               Color="Color.Secondary" 
                                               Size="Size.Small" 
                                               StartIcon="@Icons.Material.Filled.AddShoppingCart" 
                                               Class="mud-elevation-4"
                                               Disabled="@(prod.Stock == 0)"
                                               OnClick="() => AgregarAlCarrito(prod)">
                                        @(prod.Stock > 0 ? "Agregar" : "Agotado")
                                    </MudButton>
                                </NotAuthorized>
                            </AuthorizeView>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>
</MudContainer>

@code {
    private List<ProductoModel>? productos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            productos = await Http.GetFromJsonAsync<List<ProductoModel>>("https://localhost:7133/api/productos");
        }
        catch (Exception)
        {
            Snackbar.Add("Error al cargar el catálogo", Severity.Error);
        }
    }

    private async Task AgregarAlCarrito(ProductoModel producto)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Validamos si es anónimo
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            Snackbar.Add("Debes iniciar sesión como cliente para comprar.", Severity.Warning);
            return; 
        }

        // Doble validación de seguridad: Verificamos el rol antes de guardarlo en memoria
        if (!user.IsInRole("Cliente"))
        {
            Snackbar.Add("Acción denegada: Solo los clientes pueden comprar.", Severity.Error);
            return;
        }

        try
        {
            ServicioCarrito.AgregarAlCarrito(producto.ProductoId, producto.Nombre, producto.Precio, producto.Stock, 1);
            Snackbar.Add($"{producto.Nombre} agregado al carrito", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }
}