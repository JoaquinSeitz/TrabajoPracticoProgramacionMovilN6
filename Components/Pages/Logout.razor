@page "/logout"
@using TrabajoPracticoProgramacionMovilN6.Services
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@code {
    protected override void OnInitialized()
    {
        // 1. Borramos el token del celular
        AuthService.Logout();

        // 2. Le avisamos a Blazor que el usuario ya no existe
        var customAuthStateProvider = (CustomAuthStateProvider)AuthStateProvider;
        customAuthStateProvider.MarcarComoDeslogueado();

        // 3. Mostramos un mensaje y lo pateamos a la pantalla de Login
        Snackbar.Add("Sesión cerrada correctamente", Severity.Info);
        Navigation.NavigateTo("/login");
    }
}