@inherits LayoutComponentBase
@implements IDisposable
@using TrabajoPracticoProgramacionMovilN6.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider Theme="@_temaTP6" />
<MudDialogProvider />
<MudSnackbarProvider PositionClass="Defaults.Classes.Position.BottomRight" PreventDuplicates="true" ShowCloseIcon="true" VisibleStateDuration="2500" />
<MudPopoverProvider />

<MudLayout>
    @* BARRA SUPERIOR *@
    <MudAppBar Color="Color.Primary" Fixed="true" Elevation="4">
        <MudText Typo="Typo.h6" Class="fw-bold">Gestión de Stock TP6</MudText>
        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Title="Mi Perfil" />
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Login" Class="mud-elevation-2">
                    Ingresar
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @* CONTENIDO PRINCIPAL *@
    <MudMainContent Class="pb-16" Style="background-color: var(--mud-palette-background); min-height: 100vh;">
        <MudContainer MaxWidth="MaxWidth.Large">
            @Body
        </MudContainer>
    </MudMainContent>

    @* BARRA INFERIOR *@
    <MudAppBar Bottom="true" Fixed="true" Style="background-color: #455A64; padding: 0;" Elevation="8">
        <div class="d-flex justify-space-evenly align-center w-100 px-1" style="height: 100%;">
            @* INICIO *@
            <MudButton Href="/" Style="@ObtenerEstiloBoton("/")" DisableRipple="true" Padding="Padding.None">
                <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Class="mt-1" Style="font-size: 10px;">Inicio</MudText>
            </MudButton>

            @* CATÁLOGO *@
            <MudButton Href="/catalogo" Style="@ObtenerEstiloBoton("/catalogo")" DisableRipple="true" Padding="Padding.None">
                <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Medium" />
                <MudText Typo="Typo.caption" Class="mt-1" Style="font-size: 10px;">Catálogo</MudText>
            </MudButton>

            @* ZONA ADMIN *@
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudButton Href="/ingresos" Style="@ObtenerEstiloBoton("/ingresos")" DisableRipple="true" Padding="Padding.None">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Medium" />
                        <MudText Typo="Typo.caption" Class="mt-1" Style="font-size: 10px;">Ingresos</MudText>
                    </MudButton>

                    <MudButton Href="/reportes" Style="@ObtenerEstiloBoton("/reportes")" DisableRipple="true" Padding="Padding.None">
                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Medium" />
                        <MudText Typo="Typo.caption" Class="mt-1" Style="font-size: 10px;">Reportes</MudText>
                    </MudButton>
                </Authorized>
            </AuthorizeView>

            @* ZONA CLIENTE *@
            <AuthorizeView Roles="Cliente">
                <Authorized>
                    <MudButton Href="/carrito" Style="@ObtenerEstiloBoton("/carrito")" DisableRipple="true" Padding="Padding.None">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Medium" />
                        <MudText Typo="Typo.caption" Class="mt-1" Style="font-size: 10px;">Carrito</MudText>
                    </MudButton>
                </Authorized>
            </AuthorizeView>

            @* LOGOUT *@
            <AuthorizeView>
                <Authorized>
                    <MudButton OnClick="CerrarSesion" Style="@ObtenerEstiloBoton("/logout")" DisableRipple="true" Padding="Padding.None">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Medium" />
                        <MudText Typo="Typo.caption" Class="mt-1" Style="font-size: 10px;">Salir</MudText>
                    </MudButton>
                </Authorized>
            </AuthorizeView>
        </div>
    </MudAppBar>
</MudLayout>

@code {
    private MudTheme _temaTP6 = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#607D8B",
            Secondary = "#CDDC39",
            AppbarBackground = "#455A64",
            Background = "#CFD8DC",
            Surface = "#ECEFF1",
            TextPrimary = "#263238",
            TextSecondary = "#546E7A"
        }
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += AlCambiarDeRuta;
    }

    private void AlCambiarDeRuta(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= AlCambiarDeRuta;
    }

    private string ObtenerEstiloBoton(string href)
    {
        var rutaActual = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        var rutaFormateada = $"/{rutaActual}";

        string estiloBase = "flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; min-width: 0; padding: 2px; border-radius: 8px; transition: all 0.3s ease; text-transform: none;";
        bool esBotonActivo = false;

        if (href == "/")
        {
            esBotonActivo = string.IsNullOrEmpty(rutaActual);
        }
        else
        {
            esBotonActivo = (rutaFormateada.Contains(href.ToLower()) && href != "/logout");
        }

        if (esBotonActivo)
        {
            return estiloBase + "color: #EEFF41; background-color: rgba(238, 255, 65, 0.15); font-weight: bold;";
        }

        return estiloBase + "color: #B0BEC5; background-color: transparent;";
    }

    private void CerrarSesion()
    {
        AuthService.Logout();
        var customAuthStateProvider = (CustomAuthStateProvider)AuthStateProvider;
        customAuthStateProvider.MarcarComoDeslogueado();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}